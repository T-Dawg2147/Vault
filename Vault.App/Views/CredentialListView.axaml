<UserControl x:Class="Vault.App.Views.CredentialListView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Credentials" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Vault:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox ItemsSource="{Binding Vaults}" SelectedItem="{Binding SelectedVault}" Width="180" DockPanel.Dock="Left">
<ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
</ComboBox>
            <TextBlock Text="  Search:" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <TextBox Text="{Binding SearchText}" MinWidth="200"/>
        </DockPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Credentials}" SelectedItem="{Binding SelectedCredential}"
                  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*"/>
                <DataGridTextColumn Header="Username" Binding="{Binding UsernameOrEmail}" Width="*"/>
                <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*"/>
                <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedAt, StringFormat=g}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Add" Classes="primary" Command="{Binding AddCredentialCommand}"/>
            <Button Content="View / Edit" Classes="primary" Command="{Binding EditCredentialCommand}"/>
            <Button Content="Copy username" Classes="primary" Command="{Binding CopyUsernameCommand}"/>
            <Button Content="Copy password" Classes="primary" Command="{Binding CopyPasswordCommand}"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="DarkRed" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
