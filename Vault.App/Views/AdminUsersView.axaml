<UserControl x:Class="Vault.App.Views.AdminUsersView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Create User Section -->
        <Border Grid.Row="0" Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="#DDD" Background="#FAFAFA">
            <StackPanel>
                <TextBlock Text="Add User" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Text="Domain and Username are required. The identity identifier (Windows SID, or user@machine on macOS/Linux) is captured automatically on the user's first sign-in. Users who open the app for the first time are registered as Viewers with no vault access; assign roles and vaults here."
                           TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,12" />

                <UniformGrid Columns="2" Rows="2" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,12,12">
                        <TextBlock Text="Domain" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewDomain}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Username" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewUsername}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Display Name" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewDisplayName}" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Role" Margin="0,0,0,4" />
                        <ComboBox SelectedItem="{Binding NewRole}" ItemsSource="{Binding Roles}" />
                    </StackPanel>
                </UniformGrid>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#B00020" TextWrapping="Wrap" Margin="0,0,0,8" />

                <Button Content="Add User"
                        Width="120"
                        HorizontalAlignment="Left"
                        Command="{Binding AddUserCommand}" />
            </StackPanel>
        </Border>

        <!-- Users List -->
        <Border Grid.Row="1" Margin="0,16,0,0" Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="#DDD">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Registered Users" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                <DataGrid ItemsSource="{Binding Users}"
                          AutoGenerateColumns="False"
                         
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="*" />
                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*" />
                        <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="*" />
                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="*" />
                        <DataGridTextColumn Header="Active" Binding="{Binding IsActive}" Width="*" />
                        <DataGridCheckBoxColumn Header="Signed in" Binding="{Binding HasSignedIn, Mode=OneWay}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Edit User Section -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="#DDD" Background="#FAFAFA">
            <StackPanel>
                <TextBlock Text="Edit Selected User" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                <UniformGrid Columns="3" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,12,12">
                        <TextBlock Text="Domain" Margin="0,0,0,4" />
                        <TextBox Text="{Binding EditDomain}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,12">
                        <TextBlock Text="Username" Margin="0,0,0,4" />
                        <TextBox Text="{Binding EditUsername}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Display Name" Margin="0,0,0,4" />
                        <TextBox Text="{Binding EditDisplayName}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Role" Margin="0,0,0,4" />
                        <ComboBox SelectedItem="{Binding EditRole}" ItemsSource="{Binding Roles}" />
                    </StackPanel>
                    <CheckBox Content="Active" IsChecked="{Binding EditIsActive}" VerticalAlignment="Bottom" Margin="0,0,12,0" />
                </UniformGrid>
                <Button Content="Save Changes" Width="120" HorizontalAlignment="Left" Command="{Binding SaveUserCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>