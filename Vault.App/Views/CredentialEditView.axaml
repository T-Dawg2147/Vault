<UserControl x:Class="Vault.App.Views.CredentialEditView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Vault.App.Views">
    <UserControl.Resources>
        <views:FlexibleBooleanConverter x:Key="BoolConv"/>
        <views:DateTimeToOffsetConverter x:Key="DateConv"/>
    </UserControl.Resources>
    <StackPanel MaxWidth="560">
        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="DarkRed" TextWrapping="Wrap"/>

        <TextBlock Text="Label *" Classes="formlabel"/>
        <TextBox Text="{Binding Label}"/>

        <TextBlock Text="Username or e-mail" Classes="formlabel"/>
        <TextBox Text="{Binding UsernameOrEmail}"/>

        <TextBlock Text="Password (leave empty on edit to keep existing)" Classes="formlabel"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Password is masked by default; only revealed on explicit toggle. -->
            <TextBox x:Name="PasswordBox" PasswordChar="&#9679;" Text="{Binding Password}"
                     IsVisible="{Binding !IsPasswordVisible}"/>
            <TextBox x:Name="PasswordRevealBox" Text="{Binding Password}"
                     IsVisible="{Binding IsPasswordVisible}"/>
            <Button Grid.Column="1" Content="{Binding IsPasswordVisible, Converter={StaticResource BoolConv}, ConverterParameter=Text}"
                    Classes="primary" Command="{Binding TogglePasswordVisibilityCommand}"/>
        </Grid>

        <TextBlock Text="URL" Classes="formlabel"/>
        <TextBox Text="{Binding Url}"/>

        <TextBlock Text="Tags (comma separated)" Classes="formlabel"/>
        <TextBox Text="{Binding Tags}"/>

        <TextBlock Text="Notes (stored encrypted)" Classes="formlabel"/>
        <TextBox Text="{Binding Notes}" AcceptsReturn="True" Height="80" TextWrapping="Wrap"/>

        <TextBlock Text="Rotation due date (optional)" Classes="formlabel"/>
        <DatePicker SelectedDate="{Binding RotationDueAt, Converter={StaticResource DateConv}}"/>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Save" Classes="primary" Command="{Binding SaveCommand}"/>
            <Button Content="Cancel" Classes="primary" Command="{Binding CancelCommand}"/>
            <Button Content="Delete" Classes="primary" Command="{Binding DeleteCommand}"
                    IsVisible="{Binding IsEditMode}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
