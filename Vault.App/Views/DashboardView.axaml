<UserControl x:Class="Vault.App.Views.DashboardView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Dashboard" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
        <TextBlock Text="{Binding WelcomeText}" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <Border Background="#E8F1FB" CornerRadius="6" Padding="16" Margin="4,0,4,12" IsVisible="{Binding HasNoAccess}">
            <TextBlock TextWrapping="Wrap"
                       Text="You don't have access to any vaults yet. Your account was registered automatically as a Viewer; ask an administrator to grant you access to the vaults you need."/>
        </Border>

        <UniformGrid Columns="3">
            <Border Background="#F3F3F3" CornerRadius="6" Padding="16" Margin="4">
                <StackPanel>
                    <TextBlock Text="Accessible vaults" Foreground="#555"/>
                    <TextBlock Text="{Binding AccessibleVaultCount}" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="#F3F3F3" CornerRadius="6" Padding="16" Margin="4">
                <StackPanel>
                    <TextBlock Text="Accessible credentials" Foreground="#555"/>
                    <TextBlock Text="{Binding AccessibleCredentialCount}" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="#FFF4E5" CornerRadius="6" Padding="16" Margin="4">
                <StackPanel>
                    <TextBlock Text="Rotation due soon" Foreground="#555"/>
                    <TextBlock Text="{Binding RotationDueCount}" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Browse credentials" Classes="primary" Command="{Binding OpenCredentialsCommand}"/>
            <Button Content="Browse vaults" Classes="primary" Command="{Binding OpenVaultsCommand}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
