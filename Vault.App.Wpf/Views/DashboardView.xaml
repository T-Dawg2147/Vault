<UserControl x:Class="Vault.App.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Dashboard" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
        <TextBlock Text="{Binding WelcomeText}" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <UniformGrid Columns="3">
            <Border Background="#F3F3F3" CornerRadius="6" Padding="16" Margin="4">
                <StackPanel>
                    <TextBlock Text="Accessible vaults" Foreground="#555"/>
                    <TextBlock Text="{Binding AccessibleVaultCount}" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="#F3F3F3" CornerRadius="6" Padding="16" Margin="4">
                <StackPanel>
                    <TextBlock Text="Accessible credentials" Foreground="#555"/>
                    <TextBlock Text="{Binding AccessibleCredentialCount}" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="#FFF4E5" CornerRadius="6" Padding="16" Margin="4">
                <StackPanel>
                    <TextBlock Text="Rotation due soon" Foreground="#555"/>
                    <TextBlock Text="{Binding RotationDueCount}" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Browse credentials" Style="{StaticResource PrimaryButton}" Command="{Binding OpenCredentialsCommand}"/>
            <Button Content="Browse vaults" Style="{StaticResource PrimaryButton}" Command="{Binding OpenVaultsCommand}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
