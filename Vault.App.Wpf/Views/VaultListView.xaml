<UserControl x:Class="Vault.App.Wpf.Views.VaultListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Vault.App.Wpf.Views">
    <UserControl.Resources>
        <views:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Vaults" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Vaults}" SelectedItem="{Binding SelectedVault}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
                <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedAt, StringFormat=g}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="DarkRed" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Open credentials" Style="{StaticResource PrimaryButton}" Command="{Binding OpenCredentialsCommand}"/>
            </StackPanel>

            <!-- Admin-only vault creation; the service layer re-checks admin rights. -->
            <GroupBox Header="Create vault (admin)" Margin="0,12,0,0"
                      Visibility="{Binding Session.IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Name" Style="{StaticResource FormLabel}"/>
                    <TextBox Text="{Binding NewVaultName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Description" Style="{StaticResource FormLabel}"/>
                    <TextBox Text="{Binding NewVaultDescription, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Create" Style="{StaticResource PrimaryButton}" Command="{Binding CreateVaultCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </Grid>
</UserControl>
