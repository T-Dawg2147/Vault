<UserControl x:Class="Vault.App.Wpf.Views.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Vault.App.Wpf.Views">
    <UserControl.Resources>
        <views:StringListJoinConverter x:Key="JoinConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Import legacy passwords (admin)" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1">
            <DockPanel Margin="0,0,0,4">
                <Button Content="Browse…" Style="{StaticResource PrimaryButton}" Command="{Binding BrowseCommand}" DockPanel.Dock="Left"/>
                <TextBlock Text="{Binding SelectedFileName}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </DockPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
                <CheckBox Content="First row is a header" IsChecked="{Binding HasHeaderRow}" VerticalAlignment="Center"/>
                <TextBlock Text="   Columns are mapped by zero-based index." VerticalAlignment="Center" Foreground="#666"/>
            </StackPanel>

            <UniformGrid Columns="5" Margin="0,4">
                <StackPanel Margin="2">
                    <TextBlock Text="Label column" Style="{StaticResource FormLabel}"/>
                    <TextBox Text="{Binding LabelColumn}"/>
                </StackPanel>
                <StackPanel Margin="2">
                    <TextBlock Text="Username column" Style="{StaticResource FormLabel}"/>
                    <TextBox Text="{Binding UsernameColumn}"/>
                </StackPanel>
                <StackPanel Margin="2">
                    <TextBlock Text="Password column" Style="{StaticResource FormLabel}"/>
                    <TextBox Text="{Binding PasswordColumn}"/>
                </StackPanel>
                <StackPanel Margin="2">
                    <TextBlock Text="URL column" Style="{StaticResource FormLabel}"/>
                    <TextBox Text="{Binding UrlColumn}"/>
                </StackPanel>
                <StackPanel Margin="2">
                    <TextBlock Text="Notes column" Style="{StaticResource FormLabel}"/>
                    <TextBox Text="{Binding NotesColumn}"/>
                </StackPanel>
            </UniformGrid>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Preview" Style="{StaticResource PrimaryButton}" Command="{Binding PreviewCommand}"/>
                <TextBlock Text="  Target vault:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                <ComboBox ItemsSource="{Binding Vaults}" SelectedItem="{Binding SelectedVault}"
                          DisplayMemberPath="Name" Width="180"/>
                <Button Content="Import into vault" Style="{StaticResource PrimaryButton}" Command="{Binding CommitCommand}"/>
            </StackPanel>
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding PreviewRows}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" Margin="0,8,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Row" Binding="{Binding RowNumber}" Width="50"/>
                <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*"/>
                <DataGridTextColumn Header="Username" Binding="{Binding UsernameOrEmail}" Width="*"/>
                <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*"/>
                <DataGridCheckBoxColumn Header="Valid" Binding="{Binding IsValid}" Width="50"/>
                <DataGridTextColumn Header="Errors" Binding="{Binding Errors, Converter={StaticResource JoinConverter}}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="DarkGreen" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="DarkRed" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
