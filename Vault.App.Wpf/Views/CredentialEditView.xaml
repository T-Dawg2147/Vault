<UserControl x:Class="Vault.App.Wpf.Views.CredentialEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Vault.App.Wpf.Views">
    <UserControl.Resources>
        <views:FlexibleBooleanConverter x:Key="BoolConv"/>
        <views:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <StackPanel MaxWidth="560">
        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="DarkRed" TextWrapping="Wrap"/>

        <TextBlock Text="Label *" Style="{StaticResource FormLabel}"/>
        <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Username or e-mail" Style="{StaticResource FormLabel}"/>
        <TextBox Text="{Binding UsernameOrEmail, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Password (leave empty on edit to keep existing)" Style="{StaticResource FormLabel}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Password is masked by default; only revealed on explicit toggle. -->
            <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"
                         Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolConv}, ConverterParameter=Inverse}"/>
            <TextBox x:Name="PasswordRevealBox" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolConv}}"/>
            <Button Grid.Column="1" Content="{Binding IsPasswordVisible, Converter={StaticResource BoolConv}, ConverterParameter=Text}"
                    Style="{StaticResource PrimaryButton}" Command="{Binding TogglePasswordVisibilityCommand}"/>
        </Grid>

        <TextBlock Text="URL" Style="{StaticResource FormLabel}"/>
        <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Tags (comma separated)" Style="{StaticResource FormLabel}"/>
        <TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Notes (stored encrypted)" Style="{StaticResource FormLabel}"/>
        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="80" TextWrapping="Wrap"/>

        <TextBlock Text="Rotation due date (optional)" Style="{StaticResource FormLabel}"/>
        <DatePicker SelectedDate="{Binding RotationDueAt}"/>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>
            <Button Content="Cancel" Style="{StaticResource PrimaryButton}" Command="{Binding CancelCommand}"/>
            <Button Content="Delete" Style="{StaticResource PrimaryButton}" Command="{Binding DeleteCommand}"
                    Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
