<Window x:Class="Vault.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Vault.App.Wpf.ViewModels"
        xmlns:views="clr-namespace:Vault.App.Wpf.Views"
        Title="Vault — Internal Password Manager" Height="640" Width="1024"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:VaultListViewModel}"><views:VaultListView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CredentialListViewModel}"><views:CredentialListView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CredentialEditViewModel}"><views:CredentialEditView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminUsersViewModel}"><views:AdminUsersView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminVaultAccessViewModel}"><views:AdminVaultAccessView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditLogViewModel}"><views:AuditLogView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImportViewModel}"><views:ImportView/></DataTemplate>
        
        <views:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Role-aware navigation. Admin items are only visible to admins; the service layer re-checks every action. -->
        <StackPanel Grid.Column="0" Background="#2D2D30">
            <TextBlock Text="Vault" Foreground="White" FontSize="20" FontWeight="Bold" Margin="12,16"/>
            <Button Content="Dashboard" Style="{StaticResource PrimaryButton}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
            <Button Content="Vaults" Style="{StaticResource PrimaryButton}" Command="{Binding NavigateCommand}" CommandParameter="Vaults"/>
            <Button Content="Credentials" Style="{StaticResource PrimaryButton}" Command="{Binding NavigateCommand}" CommandParameter="Credentials"/>
            <Separator Margin="8"/>
            <Button Content="Users" Style="{StaticResource PrimaryButton}" Command="{Binding NavigateCommand}" CommandParameter="AdminUsers"
                    Visibility="{Binding Session.IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Content="Vault Access" Style="{StaticResource PrimaryButton}" Command="{Binding NavigateCommand}" CommandParameter="AdminVaultAccess"
                    Visibility="{Binding Session.IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Content="Import" Style="{StaticResource PrimaryButton}" Command="{Binding NavigateCommand}" CommandParameter="Import"
                    Visibility="{Binding Session.IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Content="Audit Log" Style="{StaticResource PrimaryButton}" Command="{Binding NavigateCommand}" CommandParameter="AuditLog"
                    Visibility="{Binding Session.IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBlock Text="{Binding Session.CurrentUser.Username}" Foreground="#AAAAAA" Margin="12,24,12,4" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Session.CurrentUser.Role}" Foreground="#AAAAAA" Margin="12,0" FontSize="11"/>
        </StackPanel>

        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" Margin="8"/>
    </Grid>
</Window>
